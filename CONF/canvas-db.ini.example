[mysql]
host = localhost
port = 3306
database = canvas
user = CANVAS_DB_USER
password = REPLACE_WITH_LONG_PRIVATE_PASSWORD
unix_socket =

[auth]
; Generate with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
pepper = REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

; Personal Android/PC/iPad deployment: run bin/personal-access.php setup.
; It selects an existing owner and creates one-use registration codes.
; [private_access]
; enabled = true
; owner_id = EXISTING_32_HEX_USER_ID
